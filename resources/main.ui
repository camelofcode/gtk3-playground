<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkWindow" id="main_window">
    <property name="default-height">300</property>
    <property name="default-width">300</property>
    <property name="title">GTK 3 Playground</property>
    <child>
      <object class="GtkBox" id="main_window_box">
        <property name="margin-bottom">20</property>
        <property name="margin-end">20</property>
        <property name="margin-start">20</property>
        <property name="margin-top">20</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <child>
          <object class="GtkButton" id="open_text_binding_window_button">
            <property name="label">Text Binding</property>
            <signal
              name="clicked"
              handler="on_open_text_binding_window_button_clicked"
              object="text_binding_window"
              swapped="no"
            />
          </object>
        </child>
        <child>
          <object class="GtkButton" id="open_task_list_window_button">
            <property name="label">Task List</property>
            <signal
              name="clicked"
              handler="on_open_task_list_window_button_clicked"
              object="task_list_window"
              swapped="no"
            />
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkWindow" id="text_binding_window">
    <property name="default-height">150</property>
    <property name="default-width">400</property>
    <property name="title">Text Binding</property>
    <signal
      name="delete-event"
      handler="on_text_binding_window_delete_event"
      swapped="no"
    />
    <child>
      <object class="GtkBox" id="text_binding_box">
        <property name="margin-bottom">20</property>
        <property name="margin-end">20</property>
        <property name="margin-start">20</property>
        <property name="margin-top">20</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <child>
          <object class="GtkEntry" id="text_binding_input">
            <property name="placeholder-text">Type something...</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="text_binding_label">
            <property
              name="label"
              bind-source="text_binding_input"
              bind-property="text"
              bind-flags="sync-create"
            />
          </object>
        </child>
        <child>
          <object class="GtkButton" id="text_binding_button">
            <property name="label">Reset</property>
            <signal
              name="clicked"
              handler="on_text_binding_reset_clicked"
              object="text_binding_input"
              swapped="no"
            />
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkWindow" id="task_list_window">
    <property name="default-height">400</property>
    <property name="default-width">400</property>
    <property name="title">Task List</property>
    <signal
      name="delete-event"
      handler="on_task_list_window_delete_event"
      swapped="no"
    />
    <child>
      <object class="GtkBox" id="task_list_window_box">
        <property name="margin-bottom">20</property>
        <property name="margin-end">20</property>
        <property name="margin-start">20</property>
        <property name="margin-top">20</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <child>
          <object class="GtkBox" id="task_input_box">
            <property name="spacing">6</property>
            <child>
              <object class="GtkEntry" id="task_input">
                <property name="hexpand">True</property>
                <property name="placeholder-text">Add a task...</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="add_task_button">
                <property name="tooltip-text">Add task</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">list-add-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow" id="task_list_scrolled_window">
            <property name="hscrollbar-policy">never</property>
            <property name="shadow-type">in</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkListBox" id="task_list">
                <property name="selection-mode">none</property>
                <style>
                  <class name="task-list-container" />
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
